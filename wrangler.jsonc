{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Worker's name on Cloudflare (also part of its default URL).
  "name": "keyhole",
  // Entry file: where the Worker's code starts.
  "main": "worker/index.ts",
  // Pins runtime behaviour to this date so platform updates don't change our code silently.
  "compatibility_date": "2026-11-24",
  // Plain (non-secret) settings. Locally, the same names in .env override these.
  // BETTER_AUTH_SECRET is a secret: set with `wrangler secret put`, never stored here.
  "vars": {
    "BETTER_AUTH_URL": "https://keyhole.joshkingswood.workers.dev"
  },
  "assets": {
    // Unknown paths return index.html so the React router can handle them.
    "not_found_handling": "single-page-application",
    // These paths skip the asset check and go straight to the Worker.
    "run_worker_first": ["/api/*"]
  },
  // The D1 database. "binding" is the name the Worker sees: c.env.DB.
  // Locally, dev uses a SQLite file under .wrangler/; the database_id is the real one in Cloudflare.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keyhole-db",
      "database_id": "40db7f97-064a-4d2b-b03e-dd43469f9323",
      // Where Drizzle's generated SQL migrations live (used by `wrangler d1 migrations apply`).
      "migrations_dir": "drizzle"
    }
  ]
}
